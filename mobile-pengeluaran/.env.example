# Salin berkas ini menjadi .env (folder yang sama), lalu sesuaikan alamat backend.
# Awalan EXPO_PUBLIC_ berarti nilai ini memang dimaksudkan masuk bundle aplikasi,
# jadi aman di-commit. RAHASIA sungguhan (kredensial MySQL) tidak boleh di sini.
# Setelah mengubah .env, restart Metro dengan: npx expo start --clear

# Android fisik satu Wi-Fi dengan komputer backend (cek IPv4 PC: ipconfig)
EXPO_PUBLIC_API_URL=http://192.168.1.13:3000

# Alternatif lingkungan lain (ganti nilai di atas sesuai kebutuhan):
#   Emulator Android Studio  -> EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#   Web/browser di PC backend -> EXPO_PUBLIC_API_URL=http://localhost:3000